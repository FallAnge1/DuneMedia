{
  "name": "video-archive-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "uploader:create": "node scripts/uploader.mjs create",
    "uploader:revoke": "node scripts/uploader.mjs revoke",
    "uploader:list": "node scripts/uploader.mjs list",
    "types": "wrangler types --strict-vars=false",
    "pretest": "node scripts/ensure-dist.mjs",
    "predev": "node scripts/ensure-dist.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "seed": "node scripts/seed.mjs",
    "dev:ai": "wrangler dev"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.124.0"
  }
}
